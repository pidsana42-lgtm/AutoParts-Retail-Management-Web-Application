# Copy this file to .env.monitoring.production on the monitoring server.
# The Prometheus metrics password is stored separately in
# monitoring/secrets/prometheus_metrics_password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_DOMAIN=monitor.jjautopart-pakchong.com
GRAFANA_ROOT_URL=https://monitor.jjautopart-pakchong.com
GRAFANA_ENFORCE_DOMAIN=true
GRAFANA_COOKIE_SECURE=true
